FROM public.ecr.aws/docker/library/node:24.18.0-slim
RUN npm install -g npm@11 --loglevel=error

# Instalando curl
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

# Copiar package.json raiz primeiro
COPY package*.json ./
RUN npm install --loglevel=error

# Copiar os arquivos do backend (o client/ fica de fora via Dockerfile.backend.dockerignore)
COPY . .

EXPOSE 8080

CMD [ "npm", "start" ]
